# Data, weights, and simulator output stay out of git
data/
datasets/
checkpoints/
# ...except the two students the published certificate actually loads. 403 KB total:
# without them a clone contains the answer (sustained_bound.json) and nothing that
# produced it. Every other checkpoint (teachers, DAgger rounds, width variants) stays out.
!pipeline/checkpoints/
pipeline/checkpoints/*
!pipeline/checkpoints/S_clear_84x28.pth
!pipeline/checkpoints/S_mixed_84x28_w3.pth
# ...and the Town06 deployment-test routes. These are PROTOCOL artifacts, not data:
# the route had to be fixed, on geometry alone, before any Town06 model existed, and
# committing it is what makes that checkable later. ~23 KB each.
!pipeline/data/
pipeline/data/*
!pipeline/data/routes_town06/
runs/
results/**/*.png
results/**/*.npy
# .npz captures are simulator output: 18 GB of them, regenerable from the scripts.
# The .npy rule above did not cover the compressed archives the capture scripts write.
results/**/*.npz
results/traces/
results/**/*.pt
!results/ledger/

# Python
__pycache__/
*.py[cod]
.venv/
venv*/
.pytest_cache/
*.egg-info/

# Local notes
scratch/

# trajectory frame logs: ~0.5 GB per lap, regenerable
results/traj/
results/trajectory/*.json

# driven-frame logs (regenerable; 144 MB per run)
results/framelog/

# Town06 deployment test: captures are simulator output (~38 MB x 8) and regenerable.
# The CERTIFICATE is not -- it is the pre-drive prediction and must be committed.
results/town06/captures/
results/town06_logs/
!results/town06/
!results/town06/certificate_town06.json
!results/town06/ledger/

# Determinism campaign (T06-F22). The SUMMARIES are the result and are committed; the
# per-rep traces and raw frame dumps are bulk evidence, regenerable from the probes in
# scripts/determinism_*.py, and raw frames are large binaries.
results/town06/determinism/*_rep*.json
results/town06/determinism/frames/
