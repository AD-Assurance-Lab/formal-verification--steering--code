# Data, weights, and simulator output stay out of git
data/
datasets/
checkpoints/
# ...except the two students the published certificate actually loads. 403 KB total:
# without them a clone contains the answer (sustained_bound.json) and nothing that
# produced it. Every other checkpoint (teachers, DAgger rounds, width variants) stays out.
!pipeline/checkpoints/
pipeline/checkpoints/*
!pipeline/checkpoints/S_clear_84x28.pth
!pipeline/checkpoints/S_mixed_84x28_w3.pth
runs/
results/**/*.png
results/**/*.npy
# .npz captures are simulator output: 18 GB of them, regenerable from the scripts.
# The .npy rule above did not cover the compressed archives the capture scripts write.
results/**/*.npz
results/traces/
results/**/*.pt
!results/ledger/

# Python
__pycache__/
*.py[cod]
.venv/
venv*/
.pytest_cache/
*.egg-info/

# Local notes
scratch/

# trajectory frame logs: ~0.5 GB per lap, regenerable
results/traj/
results/trajectory/*.json

# driven-frame logs (regenerable; 144 MB per run)
results/framelog/
